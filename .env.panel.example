MONKEYCODE_PANEL_HOST=127.0.0.1
MONKEYCODE_PANEL_PORT=4180
MONKEYCODE_PANEL_PASSWORD=replace-with-a-long-random-admin-password
MONKEYCODE_MASTER_KEY=replace-with-32-random-bytes-in-base64
MONKEYCODE_DATA_DIR=/var/lib/monkeycode-panel
MONKEYCODE_SECURE_COOKIE=true
MONKEYCODE_BROWSER_BRIDGE_ENABLED=true
MONKEYCODE_NODE_POOL_URL=
MONKEYCODE_NODE_POOL_PUBLIC_URL=https://pool.pxyb.cn
MK_ADMIN_TOKEN=
