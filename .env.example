# MonkeyCode panel
MONKEYCODE_PANEL_HOST=127.0.0.1
MONKEYCODE_PANEL_PORT=4180
MONKEYCODE_MASTER_KEY=replace-with-32-random-bytes-in-base64
MONKEYCODE_DATA_DIR=./data
MONKEYCODE_SECURE_COOKIE=true
MONKEYCODE_BROWSER_BRIDGE_ENABLED=true

# MY unified login (fill client credentials created in the MY console)
MY_ISSUER=https://pxyb.cn
MY_CLIENT_ID=
MY_CLIENT_SECRET=
MY_REDIRECT_URI=https://mk.pxyb.cn/auth/my/callback
MY_REQUIRED_ROLE=super_admin
SESSION_SECRET=replace-with-an-independent-random-value-of-at-least-32-characters

# Legacy password login remains available alongside MY OIDC when configured
MONKEYCODE_PANEL_PASSWORD=replace-with-a-long-random-admin-password

# Optional image override
MONKEYCODE_IMAGE_TAG=latest
