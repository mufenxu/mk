# MonkeyCode panel
MONKEYCODE_PANEL_HOST=127.0.0.1
MONKEYCODE_PANEL_PORT=4180
MONKEYCODE_PANEL_PASSWORD=replace-with-a-long-random-admin-password
MONKEYCODE_MASTER_KEY=replace-with-32-random-bytes-in-base64
MONKEYCODE_DATA_DIR=./data
MONKEYCODE_SECURE_COOKIE=true
MONKEYCODE_BROWSER_BRIDGE_ENABLED=true

# Node Pool integration
MONKEYCODE_NODE_POOL_URL=http://127.0.0.1:4190
MONKEYCODE_NODE_POOL_PUBLIC_URL=https://mk.pxyb.cn/node-pool
MK_MANAGEMENT_URL=https://mk.pxyb.cn/#deployments
MK_ADMIN_TOKEN=replace-with-a-long-random-admin-token
MK_WORKER_SECRET=replace-with-at-least-32-random-characters

# Optional image overrides
MONKEYCODE_IMAGE_TAG=latest
MONKEYCODE_NODE_POOL_IMAGE_TAG=node-pool-latest
