{
  "name": "monkeycode-daily-sender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight scheduled sender for an existing MonkeyCode task",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "start": "node src/panel.mjs",
    "start:local": "node --env-file=.env src/panel.mjs",
    "send": "node src/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "nodemailer": "^9.0.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "lucide": "^1.27.0"
  }
}
